<!-- hero-banner-carousel.liquid -->

{%- liquid
  assign section_unique_name = section.id | remove: '-' | remove: '_'
-%}

{%- style -%}
  #hero-carousel-section-{{ section.id }} {
    position: relative;
    width: 100%;
  }

  #hero-carousel-section-{{ section.id }} *,
  #hero-carousel-section-{{ section.id }} *::before,
  #hero-carousel-section-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #hero-carousel-section-{{ section.id }} .carousel-nav-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  #hero-carousel-section-{{ section.id }} .hero-carousel-swiper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  #hero-carousel-section-{{ section.id }} .swiper-wrapper {
    display: flex;
    align-items: stretch;
    width: 100%;
    height: auto;
  }

  #hero-carousel-section-{{ section.id }} .swiper-slide {
    flex-shrink: 0;
    width: 100%;
    height: auto;
    min-width: 0;
  }

  #hero-carousel-section-{{ section.id }} .hero-split-slide {
    display: flex;
    align-items: stretch;
    width: 100%;
    height: 100%;
    min-width: 0;
  }

  #hero-carousel-section-{{ section.id }} .hero-split-media {
    position: relative;
    flex: 0 0 70%;
    width: 70%;
    min-width: 0;
    overflow: hidden;
  }

  #hero-carousel-section-{{ section.id }} .hero-split-media.desktop-full-media,
  #hero-carousel-section-{{ section.id }} .hero-split-media.full-width-media {
    flex-basis: 100%;
    width: 100%;
  }

  #hero-carousel-section-{{ section.id }} .hero-split-content {
    position: relative;
    flex: 0 0 30%;
    width: 30%;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 31px;
    background: #fff6f2;
  }

  #hero-carousel-section-{{ section.id }} .hero-content-hidden,
  #hero-carousel-section-{{ section.id }} .hero-content-mobile-only {
    display: none;
  }

  #hero-carousel-section-{{ section.id }} .square-banner-slide {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  /* Important: let image/video intrinsic ratio create the slide height.
     Using height:100% here with Swiper autoHeight can collapse lazy-loaded next slides. */
  #hero-carousel-section-{{ section.id }} .square-banner-media,
  #hero-carousel-section-{{ section.id }} .square-banner-slide img,
  #hero-carousel-section-{{ section.id }} .square-banner-slide video,
  #hero-carousel-section-{{ section.id }} .square-banner-slide picture {
    display: block;
    width: 100%;
    max-width: 100%;
  }

  #hero-carousel-section-{{ section.id }} .square-banner-slide picture {
    height: auto;
  }

  #hero-carousel-section-{{ section.id }} .square-banner-media,
  #hero-carousel-section-{{ section.id }} .square-banner-slide img,
  #hero-carousel-section-{{ section.id }} .square-banner-slide video {
    height: auto;
    object-fit: cover;
    opacity: 1 !important;
    visibility: visible !important;
  }

  #hero-carousel-section-{{ section.id }} .hero-video-desktop {
    display: block;
  }

  #hero-carousel-section-{{ section.id }} .hero-video-mobile {
    display: none;
  }

  #hero-carousel-section-{{ section.id }} .gradient_look {
    position: relative;
  }

  #hero-carousel-section-{{ section.id }} .gradient_look::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 1;
    width: 50%;
    height: 100%;
    pointer-events: none;
  }

  #hero-carousel-section-{{ section.id }} .white-gradient::before {
    background: linear-gradient(90deg, rgba(255,255,255,.8) 0%, rgba(255,255,255,0) 100%);
  }

  #hero-carousel-section-{{ section.id }} .black-gradient::before {
    background: linear-gradient(90deg, rgba(0,0,0,.6) 0%, rgba(0,0,0,0) 100%);
  }

  #hero-carousel-section-{{ section.id }} .banner-info-content {
    width: 92%;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(18px, 1.5vw, 32px);
  }

  #hero-carousel-section-{{ section.id }} .banner-info-content-logo img {
    display: block;
    width: auto;
    max-width: 100%;
    height: clamp(20px, 4vw, 48px);
    object-fit: contain;
  }

  #hero-carousel-section-{{ section.id }} .content_main_banner,
  #hero-carousel-section-{{ section.id }} .content_main_banner p,
  #hero-carousel-section-{{ section.id }} .content_main_banner h1,
  #hero-carousel-section-{{ section.id }} .content_main_banner h2,
  #hero-carousel-section-{{ section.id }} .content_main_banner h3,
  #hero-carousel-section-{{ section.id }} .content_main_banner h4,
  #hero-carousel-section-{{ section.id }} .content_main_banner h5,
  #hero-carousel-section-{{ section.id }} .content_main_banner h6 {
    margin: 0;
    font-family: "VinilaCondensed", "Vinila Condensed Test", sans-serif;
    font-size: 30px;
    line-height: 32px;
    font-weight: 400;
  }

  #hero-carousel-section-{{ section.id }} .banner-info-text-height {
    height: 10px;
  }

  #hero-carousel-section-{{ section.id }} .sub-content_main_banner,
  #hero-carousel-section-{{ section.id }} .sub-content_main_banner p {
    margin: 0;
    color: #252525;
    font-family: "elza", sans-serif;
    font-size: clamp(14px, 1.5vw, 20px);
    font-style: normal;
    font-weight: 400;
    line-height: normal;
  }

  #hero-carousel-section-{{ section.id }} .text-white,
  #hero-carousel-section-{{ section.id }} .text-white .content_main_banner,
  #hero-carousel-section-{{ section.id }} .text-white .content_main_banner p,
  #hero-carousel-section-{{ section.id }} .text-white .sub-content_main_banner,
  #hero-carousel-section-{{ section.id }} .text-white .sub-content_main_banner p {
    color: #fff;
  }

  #hero-carousel-section-{{ section.id }} .text-dark,
  #hero-carousel-section-{{ section.id }} .text-dark .content_main_banner,
  #hero-carousel-section-{{ section.id }} .text-dark .content_main_banner p,
  #hero-carousel-section-{{ section.id }} .text-dark .sub-content_main_banner,
  #hero-carousel-section-{{ section.id }} .text-dark .sub-content_main_banner p {
    color: #252525;
  }

  #hero-carousel-section-{{ section.id }} .banner-info-content-button {
    width: 100%;
  }

  #hero-carousel-section-{{ section.id }} .banner-info-content-button .hero-banner-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    min-height: 42px;
    padding: 10px 34px;
    margin-top: 24px;
    border-radius: 100px;
    font-family: "elza", sans-serif;
    font-size: clamp(16px, 1.2vw, 18px);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color .3s ease, color .3s ease, border-color .3s ease;
  }

  #hero-carousel-section-{{ section.id }} .banner-info-content-button .button-style-dark {
    width: min(73%, 320px);
    border: 1px solid transparent;
    background: var(--hero-button-bg, #937ef9);
    color: #fff;
    white-space: nowrap;
  }

  #hero-carousel-section-{{ section.id }} .banner-info-content-button .button-style-dark:hover {
    background: #000;
    color: #fff;
  }

  #hero-carousel-section-{{ section.id }} .banner-info-content-button .button-style-white {
    width: min(73%, 320px);
    border: 1px solid #fff;
    background: transparent;
    color: #fff;
    white-space: nowrap;
  }

  #hero-carousel-section-{{ section.id }} .banner-info-content-button .button-style-white:hover {
    background: #fff;
    color: #000;
  }

  #hero-carousel-section-{{ section.id }} .banner-info-top-tag {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 3;
    width: auto;
    height: clamp(50px, 8vw, 110px);
    pointer-events: none;
  }

  #hero-carousel-section-{{ section.id }} .banner-info-top-tag svg,
  #hero-carousel-section-{{ section.id }} .banner-info-top-tag img {
    display: block;
    width: auto;
    max-width: 100%;
    height: 100%;
  }

  #hero-carousel-section-{{ section.id }} .banner-info-bottom-tag {
    position: absolute;
    bottom: 24px;
    right: 24px;
    z-index: 3;
    width: auto;
    height: clamp(30px, 4vw, 50px);
    opacity: .5;
    pointer-events: none;
  }

  #hero-carousel-section-{{ section.id }} .banner-info-bottom-tag img {
    display: block;
    width: auto;
    height: 100%;
    object-fit: contain;
  }

  #hero-carousel-section-{{ section.id }} .custom-logo {
    position: relative;
  }

  #hero-carousel-section-{{ section.id }} .custom-logo.has-badge::before {
    content: "";
    position: absolute;
    top: -9px;
    right: 25px;
    z-index: 1;
    width: 113px;
    height: 110px;
    background-image: var(--badge-bg, none);
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    pointer-events: none;
  }

  #hero-carousel-section-{{ section.id }} .banner-info-content {
    position: relative;
    z-index: 2;
  }

  /* Navigation overlay: buttons are positioned independently so theme/global flex CSS cannot pull both arrows to the left. */
  #hero-carousel-section-{{ section.id }} .slider_arrows {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  #hero-carousel-section-{{ section.id }} .slider_arrows .carousel-btn {
    position: absolute;
    top: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
    transform: translateY(-50%);
  }

  #hero-carousel-section-{{ section.id }} #carousel-prev-{{ section.id }} {
    left: 16px;
  }

  #hero-carousel-section-{{ section.id }} #carousel-next-{{ section.id }} {
    right: 16px;
    left: auto;
  }

  #hero-carousel-section-{{ section.id }} .slider_arrows .carousel-btn svg {
    width: 50px;
    height: 50px;
    opacity: 1;
    transition: opacity .3s ease, transform .3s ease;
  }

  #hero-carousel-section-{{ section.id }}:hover .slider_arrows .carousel-btn svg,
  #hero-carousel-section-{{ section.id }} .slider_arrows .carousel-btn:focus-visible svg {
    opacity: 1;
  }

  #hero-carousel-section-{{ section.id }} .slider_arrows .carousel-btn:hover svg {
    transform: scale(1.05);
  }

  #hero-carousel-section-{{ section.id }} .disabled_swiper_button {
    opacity: .35;
    pointer-events: none;
  }

  #hero-pagination-wrapper-{{ section.id }} {
    position: absolute;
    left: 50%;
    bottom: {{ section.settings.pagination_margin_top }}px;
    z-index: 6;
    display: none;
    align-items: center;
    justify-content: center;
    width: auto;
    min-height: 14px;
    transform: translateX(-50%);
  }

  #hero-pagination-wrapper-{{ section.id }}.swiper-pagination {
    gap: 6px;
  }

  #hero-pagination-wrapper-{{ section.id }} .swiper-pagination-bullet,
  #hero-pagination-wrapper-{{ section.id }}.swiper-pagination .swiper-pagination-bullet {
    position: relative;
    width: 6px;
    height: 6px;
    margin: 0 3px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, .07);
    border-radius: 999px;
    background: rgba(0, 0, 0, .07);
    color: transparent;
    font-size: 0;
    opacity: 1;
    cursor: pointer;
    transition: width .3s ease, background .3s ease;
  }

  #hero-pagination-wrapper-{{ section.id }} .swiper-pagination-bullet::after,
  #hero-pagination-wrapper-{{ section.id }}.swiper-pagination .swiper-pagination-bullet::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--bullet-progress, 0%);
    height: 100%;
    border-radius: inherit;
    background: #000;
    transition: width .1s linear;
  }

  #hero-pagination-wrapper-{{ section.id }} .swiper-pagination-bullet-active,
  #hero-pagination-wrapper-{{ section.id }}.swiper-pagination .swiper-pagination-bullet-active {
    width: 30px;
    background: transparent;
  }

  #hero-carousel-section-{{ section.id }} .desktop_screen {
    display: block;
  }

  #hero-carousel-section-{{ section.id }} .mobile_screen {
    display: none;
  }

  @media screen and (min-width: 768px) {
    #hero-carousel-section-{{ section.id }} .gradient_mobile::before {
      display: none;
    }

    #hero-carousel-section-{{ section.id }} .hero-content-desktop-only {
      display: flex;
    }
  }

  @media screen and (max-width: 767px) {
    #hero-carousel-section-{{ section.id }} .desktop_screen {
      display: none !important;
    }

    #hero-carousel-section-{{ section.id }} .mobile_screen {
      display: block;
    }

    #hero-carousel-section-{{ section.id }} .hero-video-desktop {
      display: none !important;
    }

    #hero-carousel-section-{{ section.id }} .hero-video-mobile {
      display: block !important;
    }

    #hero-carousel-section-{{ section.id }} .hero-split-slide {
      flex-direction: column;
    }

    #hero-carousel-section-{{ section.id }} .hero-split-media,
    #hero-carousel-section-{{ section.id }} .hero-split-media.desktop-full-media,
    #hero-carousel-section-{{ section.id }} .hero-split-media.full-width-media {
      order: 1;
      flex: 0 0 auto;
      width: 100%;
    }

    #hero-carousel-section-{{ section.id }} .hero-split-content {
      order: 2;
      flex: 0 0 auto;
      width: 100%;
      min-height: 250px;
      padding: 16px 24px 32px;
      align-items: flex-start;
      justify-content: flex-start;
      overflow: visible;
    }

    #hero-carousel-section-{{ section.id }} .hero-content-desktop-only,
    #hero-carousel-section-{{ section.id }} .hero-content-hidden {
      display: none !important;
    }

    #hero-carousel-section-{{ section.id }} .hero-content-mobile-only,
    #hero-carousel-section-{{ section.id }} .hero-content-all {
      display: flex;
    }

    #hero-carousel-section-{{ section.id }} .banner-info-content {
      width: 100%;
      gap: 16px;
      justify-content: flex-start;
    }

    #hero-carousel-section-{{ section.id }} .content_main_banner,
    #hero-carousel-section-{{ section.id }} .content_main_banner p,
    #hero-carousel-section-{{ section.id }} .content_main_banner h1,
    #hero-carousel-section-{{ section.id }} .content_main_banner h2,
    #hero-carousel-section-{{ section.id }} .content_main_banner h3,
    #hero-carousel-section-{{ section.id }} .content_main_banner h4,
    #hero-carousel-section-{{ section.id }} .content_main_banner h5,
    #hero-carousel-section-{{ section.id }} .content_main_banner h6 {
      font-family: "VinilaCondensed", "Vinila Condensed Test", sans-serif;
      font-size: 30px;
      line-height: 28px;
      letter-spacing: -.6px;
    }

    #hero-carousel-section-{{ section.id }} .sub-content_main_banner,
    #hero-carousel-section-{{ section.id }} .sub-content_main_banner p {
      letter-spacing: 0;
      font-weight: 500;
    }

    #hero-carousel-section-{{ section.id }} .banner-info-content-button .hero-banner-button {
      width: 100%;
      margin-top: 8px;
      padding: 10px 28px;
    }

    #hero-carousel-section-{{ section.id }} .banner-info-top-tag {
      top: 20px;
      right: 24px;
    }

    #hero-carousel-section-{{ section.id }} .gradient_look::before {
      width: 100%;
      height: 50%;
    }

    #hero-carousel-section-{{ section.id }} .gradient_desktop::before {
      display: none;
    }

    #hero-carousel-section-{{ section.id }} .white-gradient::before {
      background: linear-gradient(180deg, rgba(255,255,255,.65) 0%, rgba(255,255,255,0) 100%);
    }

    #hero-carousel-section-{{ section.id }} .black-gradient::before {
      background: linear-gradient(180deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,0) 100%);
    }

    #hero-pagination-wrapper-{{ section.id }} {
      display: flex;
    }
  }
{%- endstyle -%}

<div id="hero-carousel-section-{{ section.id }}" class="section-{{ section.id }}-margin">
  <div class="{% if section.settings.showContainer != blank %}{{ section.settings.showContainer }} {% endif %}carousel-section-wrapper{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="carousel-nav-wrapper">
      <div
        id="hero-banner-layout-{{ section.id }}"
        class="swiper hero-carousel-swiper carousel-wrapper-outer overflow-hidden jjj"
        data-section-id="{{ section.id }}"
        data-slide-count="{{ section.blocks.size }}"
      >
        <div class="swiper-wrapper carousel-wrapper-inner">
          {% for block in section.blocks %}
            {% liquid
              assign desktop_image = block.settings['banner-image-desktop']
              assign mobile_image = block.settings['banner-image-mobile']
              assign media_desktop = block.settings['banner-video-desktop']
              assign media_mobile = block.settings['banner-video-mobile']
              assign badge_bg = block.settings['birthday-sale']

              if desktop_image == blank and mobile_image != blank
                assign desktop_image = mobile_image
              endif

              if media_desktop == blank and media_mobile != blank
                assign media_desktop = media_mobile
                assign media_mobile = blank
              endif

              assign loading_attr = 'eager'
              if forloop.first
                assign fetch_priority = 'high'
              else
                assign fetch_priority = 'auto'
              endif

              assign display_option = block.settings.timer_button_display | default: 'button'

              assign show_timer = false
              if display_option == 'timer' or display_option == 'both'
                if block.settings.deadline_date != blank and block.settings.deadline_time != blank
                  assign show_timer = true
                endif
              endif

              assign show_button = false
              if display_option == 'button' or display_option == 'both'
                if block.settings.button_style != 'none' and block.settings.button_text != blank
                  assign show_button = true
                endif
              endif

              assign desktop_title = block.settings.cta_text
              assign desktop_subtext = block.settings.cta_subtext
              assign mobile_title = block.settings.cta_text_mobile
              assign mobile_subtext = block.settings.cta_subtext_mobile

              if mobile_title == blank
                assign mobile_title = desktop_title
              endif

              if mobile_subtext == blank
                assign mobile_subtext = desktop_subtext
              endif

              assign has_content = false
              unless block.settings.full_width_image
                if block.settings.logo != blank or desktop_title != blank or desktop_subtext != blank or mobile_title != blank or mobile_subtext != blank or show_button or show_timer
                  assign has_content = true
                endif
              endunless

              assign content_visibility = block.settings.content_visibility | default: 'd-flex'
              assign content_visibility_class = 'hero-content-all'
              assign desktop_media_full = false

              case content_visibility
                when 'd-none d-md-flex'
                  assign content_visibility_class = 'hero-content-desktop-only'
                when 'd-flex d-md-none'
                  assign content_visibility_class = 'hero-content-mobile-only'
                  assign desktop_media_full = true
                when 'd-none'
                  assign content_visibility_class = 'hero-content-hidden'
                  assign desktop_media_full = true
                else
                  assign content_visibility_class = 'hero-content-all'
              endcase

              unless has_content
                assign desktop_media_full = true
              endunless

              if block.settings.full_width_image
                assign desktop_media_full = true
              endif

              assign button_bg_color = block.settings['button-color'] | default: '#937EF9'
              if block.type == 'video-media'
                assign button_bg_color = block.settings['button-color-v'] | default: '#937EF9'
              endif

              if show_timer
                assign countdown_deadline = block.settings.deadline_date | append: 'T' | append: block.settings.deadline_time | append: ':00+05:30'
              endif

              assign image_alt = desktop_image.alt
              if image_alt == blank
                assign image_alt = desktop_title | strip_html
              endif
            %}

            <div
              class="swiper-slide"
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              <div class="hero-split-slide">
                <div class="hero-split-media{% if desktop_media_full %} desktop-full-media{% endif %}{% if block.settings.full_width_image %} full-width-media{% endif %}">
                  {% if block.settings['banner-url'] != blank %}
                    <a
                      href="{{ block.settings['banner-url'] }}"
                      class="square-banner-slide{% if block.settings.show_gradient != 'none' %} gradient_look {{ block.settings.show_gradient }} {{ block.settings.gradient_condition }}{% endif %}"
                      {% if section.settings.seo_text != blank %}
                        data-location="{{ section.settings.seo_text | append: forloop.index }}"
                      {% endif %}
                    >
                  {% else %}
                    <div
                      class="square-banner-slide{% if block.settings.show_gradient != 'none' %} gradient_look {{ block.settings.show_gradient }} {{ block.settings.gradient_condition }}{% endif %}"
                      {% if section.settings.seo_text != blank %}
                        data-location="{{ section.settings.seo_text | append: forloop.index }}"
                      {% endif %}
                    >
                  {% endif %}

                  {% case block.type %}
                    {% when 'image-media' %}
                      {% if desktop_image != blank %}
                        <picture>
                          {% if mobile_image != blank %}
                            <source
                              media="(max-width: 767px)"
                              srcset="
                                {{ mobile_image | image_url: width: 320, format: 'webp' }} 320w,
                                {{ mobile_image | image_url: width: 390, format: 'webp' }} 390w,
                                {{ mobile_image | image_url: width: 480, format: 'webp' }} 480w,
                                {{ mobile_image | image_url: width: 550, format: 'webp' }} 550w,
                                {{ mobile_image | image_url: width: 750, format: 'webp' }} 750w
                              "
                              sizes="100vw"
                            >
                          {% endif %}

                          <img
                            src="{{ desktop_image | image_url: width: 1280, format: 'webp' }}"
                            srcset="
                              {{ desktop_image | image_url: width: 768, format: 'webp' }} 768w,
                              {{ desktop_image | image_url: width: 960, format: 'webp' }} 960w,
                              {{ desktop_image | image_url: width: 1100, format: 'webp' }} 1100w,
                              {{ desktop_image | image_url: width: 1280, format: 'webp' }} 1280w,
                              {{ desktop_image | image_url: width: 1440, format: 'webp' }} 1440w,
                              {{ desktop_image | image_url: width: 1920, format: 'webp' }} 1920w
                            "
                            sizes="{% if desktop_media_full %}(min-width: 768px) 100vw, 100vw{% else %}(min-width: 768px) 70vw, 100vw{% endif %}"
                            width="{{ desktop_image.width }}"
                            height="{{ desktop_image.height }}"
                            loading="{{ loading_attr }}"
                            fetchpriority="{{ fetch_priority }}"
                            decoding="async"
                            class="square-banner-media"
                            alt="{{ image_alt | escape }}"
                          >
                        </picture>
                      {% endif %}

                    {% when 'video-media' %}
                      {% if media_desktop != blank %}
                        {% if media_mobile != blank %}
                          {{
                            media_desktop
                            | video_tag:
                              image_size: '1280x',
                              width: '100%',
                              height: 'auto',
                              class: 'hero-video-desktop square-banner-media',
                              autoplay: true,
                              loop: true,
                              muted: true,
                              controls: false,
                              playsinline: true
                          }}
                          {{
                            media_mobile
                            | video_tag:
                              image_size: '750x',
                              width: '100%',
                              height: 'auto',
                              class: 'hero-video-mobile square-banner-media',
                              autoplay: true,
                              loop: true,
                              muted: true,
                              controls: false,
                              playsinline: true
                          }}
                        {% else %}
                          {{
                            media_desktop
                            | video_tag:
                              image_size: '1280x',
                              width: '100%',
                              height: 'auto',
                              class: 'square-banner-media',
                              autoplay: true,
                              loop: true,
                              muted: true,
                              controls: false,
                              playsinline: true
                          }}
                        {% endif %}
                      {% endif %}
                  {% endcase %}

                  {% if block.settings['banner-url'] != blank %}
                    </a>
                  {% else %}
                    </div>
                  {% endif %}

                  {% if block.settings.banner_top_tag != 'none' %}
                    <div class="banner-info-top-tag" aria-hidden="true">
                      {% case block.settings.banner_top_tag %}
                        {% when 'bestseller' %}
                          {{ 'Bestseller_tag.svg' | inline_asset_content }}
                        {% when 'hok_exclusive' %}
                          {{ 'Hok exclusive_tag.svg' | inline_asset_content }}
                        {% when 'limited_stock' %}
                          {{ 'Limited stock_tag.svg' | inline_asset_content }}
                        {% when 'new_launch' %}
                          {{ 'New launch_tag.svg' | inline_asset_content }}
                        {% when 'new_sale' %}
                          {{ 'On sale_tag.svg' | inline_asset_content }}
                        {% when 'trending' %}
                          {{ 'Trending_tag.svg' | inline_asset_content }}
                      {% endcase %}
                    </div>
                  {% endif %}

                  {% if block.settings.banner_bottom_logo != blank %}
                    <div class="banner-info-bottom-tag desktop_screen">
                      <img
                        src="{{ block.settings.banner_bottom_logo | image_url: height: 50, format: 'png' }}"
                        height="{{ block.settings.banner_bottom_logo.height }}"
                        width="{{ block.settings.banner_bottom_logo.width }}"
                        loading="lazy"
                        alt=""
                      >
                    </div>
                  {% endif %}
                </div>

                {% if has_content %}
                  <div
                    class="custom-logo hero-split-content {{ content_visibility_class }}{% if badge_bg != blank %} has-badge{% endif %}"
                    style="{% if block.settings.gradient_bg != blank %}background: {{ block.settings.gradient_bg }};{% endif %}{% if badge_bg != blank %}--badge-bg: url('{{ badge_bg | image_url: width: 226 }}');{% endif %}"
                  >
                    <div class="banner-info-content">
                      {% if block.settings.logo != blank %}
                        <div class="banner-info-content-logo">
                          <img
                            src="{{ block.settings.logo | image_url: height: 96, format: 'png' }}"
                            alt="{{ block.settings.logo.alt | default: section.settings.seo_text | escape }}"
                            height="{{ block.settings.logo.height }}"
                            width="{{ block.settings.logo.width }}"
                            loading="lazy"
                          >
                        </div>
                      {% endif %}

                      {% if desktop_title != blank or desktop_subtext != blank %}
                        <div class="banner-info-content-text desktop_screen">
                          <div class="banner-info-text {{ block.settings.text_style }}">
                            {% if desktop_title != blank %}
                              <div class="content_main_banner">{{ desktop_title }}</div>
                            {% endif %}
                            {% if desktop_title != blank and desktop_subtext != blank %}
                              <div class="banner-info-text-height"></div>
                            {% endif %}
                            {% if desktop_subtext != blank %}
                              <div class="sub-content_main_banner">{{ desktop_subtext }}</div>
                            {% endif %}
                          </div>
                        </div>
                      {% endif %}

                      {% if mobile_title != blank or mobile_subtext != blank %}
                        <div class="banner-info-content-text mobile_screen">
                          <div class="banner-info-text {{ block.settings.text_style }}">
                            {% if mobile_title != blank %}
                              <div class="content_main_banner">{{ mobile_title }}</div>
                            {% endif %}
                            {% if mobile_title != blank and mobile_subtext != blank %}
                              <div class="banner-info-text-height"></div>
                            {% endif %}
                            {% if mobile_subtext != blank %}
                              <div class="sub-content_main_banner">{{ mobile_subtext }}</div>
                            {% endif %}
                          </div>
                        </div>
                      {% endif %}

                      {% if show_timer %}
                        <div class="banner-sale-timer">
                          {% render 'sale-timer', color: button_bg_color, countdown_deadline_custom: countdown_deadline %}
                        </div>
                      {% endif %}

                      {% if show_button %}
                        <div class="banner-info-content-button">
                          {% if block.settings['banner-url'] != blank %}
                            <a
                              href="{{ block.settings['banner-url'] }}"
                              class="hero-banner-button {{ block.settings.button_style }}"
                              style="--hero-button-bg: {{ button_bg_color }};"
                            >
                              {{ block.settings.button_text }}
                            </a>
                          {% else %}
                            <span
                              class="hero-banner-button {{ block.settings.button_style }}"
                              style="--hero-button-bg: {{ button_bg_color }}; cursor: default;"
                            >
                              {{ block.settings.button_text }}
                            </span>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 1 %}
        <div class="desktop_screen slider_arrows" aria-label="Hero slider navigation">
          <button
            id="carousel-prev-{{ section.id }}"
            class="carousel-btn"
            type="button"
            aria-label="Previous slide"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <rect width="40" height="40" rx="20" transform="matrix(-1 0 0 1 40 0)" fill="#2D2D2D" fill-opacity="0.16"/>
              <path d="M23 14L17.1414 19.8586C17.0633 19.9367 17.0633 20.0633 17.1414 20.1414L23 26" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </button>

          <button
            id="carousel-next-{{ section.id }}"
            class="carousel-btn"
            type="button"
            aria-label="Next slide"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <rect width="40" height="40" rx="20" fill="#2D2D2D" fill-opacity="0.16"></rect>
              <path d="M17 14L22.8586 19.8586C22.9367 19.9367 22.9367 20.0633 22.8586 20.1414L17 26" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      {% endif %}

      {% if section.blocks.size > 1 %}
        <div id="hero-pagination-wrapper-{{ section.id }}" class="swiper-pagination" aria-label="Hero slider pagination"></div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  (() => {
    const sectionId = '{{ section.id }}';
    const registry = window.HOKHeroCarousels = window.HOKHeroCarousels || {};

    if (registry[sectionId] && typeof registry[sectionId].destroy === 'function') {
      registry[sectionId].destroy();
    }

    let swiperInstance = null;
    let retryTimer = null;
    let retryCount = 0;
    const maxRetries = 30;

    const sliderSelector = '#hero-banner-layout-{{ section.id }}';
    const paginationSelector = '#hero-pagination-wrapper-{{ section.id }}';
    const prevSelector = '#carousel-prev-{{ section.id }}';
    const nextSelector = '#carousel-next-{{ section.id }}';
    let prevButton = null;
    let nextButton = null;
    let prevClickHandler = null;
    let nextClickHandler = null;

    const slideCount = {{ section.blocks.size | json }};
    const loopEnabled = {{ section.settings.loop | json }} && slideCount > 1;
    const autoplayEnabled = {{ section.settings.enable_autoplay | json }} && slideCount > 1;
    const shuffleEnabled = {{ section.settings.enableShuffle | json }} && slideCount > 1;
    const transitionSpeed = {{ section.settings.slide_speed | default: 500 | json }};
    const autoplayDelay = Number({{ section.settings.autoplay_delay | default: '16000' | json }});

    function getSliderElement() {
      return document.querySelector(sliderSelector);
    }


    function restartAutoplay(swiper) {
      if (!autoplayEnabled || !swiper || swiper.destroyed || !swiper.autoplay) return;

      if (typeof swiper.autoplay.start === 'function') {
        swiper.autoplay.stop();
        swiper.autoplay.start();
      }
    }

    function syncArrowState(swiper) {
      if (!prevButton || !nextButton) return;

      if (loopEnabled) {
        prevButton.classList.remove('disabled_swiper_button');
        nextButton.classList.remove('disabled_swiper_button');
        prevButton.disabled = false;
        nextButton.disabled = false;
        prevButton.setAttribute('aria-disabled', 'false');
        nextButton.setAttribute('aria-disabled', 'false');
        return;
      }

      const atBeginning = !!(swiper && swiper.isBeginning);
      const atEnd = !!(swiper && swiper.isEnd);

      prevButton.classList.toggle('disabled_swiper_button', atBeginning);
      nextButton.classList.toggle('disabled_swiper_button', atEnd);
      prevButton.disabled = atBeginning;
      nextButton.disabled = atEnd;
      prevButton.setAttribute('aria-disabled', atBeginning ? 'true' : 'false');
      nextButton.setAttribute('aria-disabled', atEnd ? 'true' : 'false');
    }

    function unbindArrowNavigation() {
      if (prevButton && prevClickHandler) {
        prevButton.removeEventListener('click', prevClickHandler);
      }

      if (nextButton && nextClickHandler) {
        nextButton.removeEventListener('click', nextClickHandler);
      }

      prevButton = null;
      nextButton = null;
      prevClickHandler = null;
      nextClickHandler = null;
    }

    function bindArrowNavigation(swiper) {
      unbindArrowNavigation();

      const sectionElement = document.getElementById('hero-carousel-section-{{ section.id }}');
      if (!sectionElement || !swiper || swiper.destroyed || slideCount <= 1) return;

      prevButton = sectionElement.querySelector(prevSelector);
      nextButton = sectionElement.querySelector(nextSelector);

      if (!prevButton || !nextButton) {
        console.warn(`Hero Carousel ${sectionId}: navigation buttons not found.`);
        return;
      }

      prevClickHandler = function (event) {
        event.preventDefault();
        event.stopPropagation();

        if (!swiperInstance || swiperInstance.destroyed) return;

        swiperInstance.slidePrev(transitionSpeed);
        restartAutoplay(swiperInstance);
      };

      nextClickHandler = function (event) {
        event.preventDefault();
        event.stopPropagation();

        if (!swiperInstance || swiperInstance.destroyed) return;

        swiperInstance.slideNext(transitionSpeed);
        restartAutoplay(swiperInstance);
      };

      prevButton.addEventListener('click', prevClickHandler);
      nextButton.addEventListener('click', nextClickHandler);
      syncArrowState(swiper);
    }

    function resetBullets(swiper) {
      if (!swiper || !swiper.pagination || !swiper.pagination.bullets) return;

      Array.from(swiper.pagination.bullets).forEach((bullet) => {
        bullet.style.setProperty('--bullet-progress', '0%');
      });
    }

    function setActiveBulletProgress(swiper, value) {
      if (!swiper || !swiper.pagination || !swiper.pagination.bullets) return;

      const bullets = swiper.pagination.bullets;
      const activeIndex = swiper.realIndex;

      if (!bullets.length || !bullets[activeIndex]) return;
      bullets[activeIndex].style.setProperty('--bullet-progress', `${value}%`);
    }

    function prepareSlideMedia(swiper, index) {
      if (!swiper || !swiper.slides || !swiper.slides.length) return;

      const total = swiper.slides.length;
      const normalizedIndex = ((index % total) + total) % total;
      const slide = swiper.slides[normalizedIndex];
      if (!slide) return;

      slide.querySelectorAll('img').forEach((image) => {
        if (image.loading === 'lazy') image.loading = 'eager';
        if (typeof image.decode === 'function' && !image.complete) {
          image.decode().catch(() => {});
        }
      });

      slide.querySelectorAll('video').forEach((video) => {
        video.preload = 'metadata';
      });
    }

    function prepareAdjacentMedia(swiper) {
      if (!swiper || !swiper.slides || !swiper.slides.length) return;
      prepareSlideMedia(swiper, swiper.activeIndex);
      prepareSlideMedia(swiper, swiper.activeIndex + 1);
      prepareSlideMedia(swiper, swiper.activeIndex - 1);
    }

    function updateVideos(swiper) {
      const sliderElement = getSliderElement();
      if (!sliderElement || !swiper) return;

      sliderElement.querySelectorAll('video').forEach((video) => {
        if (!video.paused) video.pause();
      });

      const activeSlide = swiper.slides && swiper.slides[swiper.activeIndex];
      if (!activeSlide) return;

      activeSlide.querySelectorAll('video').forEach((video) => {
        if (window.getComputedStyle(video).display === 'none') return;

        const playPromise = video.play();
        if (playPromise && typeof playPromise.catch === 'function') {
          playPromise.catch(() => {});
        }
      });
    }

    function updateAutoHeight(swiper, speed = 0) {
      if (
        !swiper ||
        swiper.destroyed ||
        !swiper.params ||
        swiper.params.autoHeight !== true ||
        typeof swiper.updateAutoHeight !== 'function'
      ) return;

      requestAnimationFrame(() => swiper.updateAutoHeight(speed));
    }

    function bindMediaEvents(sliderElement, swiper) {
      sliderElement.querySelectorAll('img').forEach((image) => {
        if (image.complete) return;
        image.addEventListener('load', () => updateAutoHeight(swiper, 0), { once: true });
      });

      sliderElement.querySelectorAll('video').forEach((video) => {
        video.addEventListener('loadedmetadata', () => updateAutoHeight(swiper, 0), { once: true });
      });
    }

    function shuffleSlides(sliderElement) {
      if (!shuffleEnabled || sliderElement.dataset.heroShuffled === 'true') return;

      const wrapper = sliderElement.querySelector('.swiper-wrapper');
      if (!wrapper) return;

      const slides = Array.from(wrapper.children);

      for (let i = slides.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [slides[i], slides[j]] = [slides[j], slides[i]];
      }

      slides.forEach((slide) => wrapper.appendChild(slide));
      sliderElement.dataset.heroShuffled = 'true';
    }

    function destroySwiper() {
      clearTimeout(retryTimer);
      retryTimer = null;
      retryCount = 0;

      const sliderElement = getSliderElement();
      unbindArrowNavigation();

      if (swiperInstance && !swiperInstance.destroyed) {
        swiperInstance.destroy(true, true);
      } else if (sliderElement && sliderElement.swiper && !sliderElement.swiper.destroyed) {
        sliderElement.swiper.destroy(true, true);
      }

      swiperInstance = null;
    }

    function initSwiper() {
      const sliderElement = getSliderElement();
      if (!sliderElement) return;

      if (typeof window.Swiper === 'undefined') {
        if (retryCount < maxRetries) {
          retryCount += 1;
          retryTimer = window.setTimeout(initSwiper, 100);
        } else {
          console.warn(`Hero Carousel ${sectionId}: Swiper library was not found.`);
        }
        return;
      }

      retryCount = 0;
      clearTimeout(retryTimer);

      if (sliderElement.swiper && !sliderElement.swiper.destroyed) {
        sliderElement.swiper.destroy(true, true);
      }

      shuffleSlides(sliderElement);

      // Hero slides must already have their media available before navigation.
      // This prevents a lazy/loop duplicate from appearing as a blank slide.
      sliderElement.querySelectorAll('img').forEach((image) => {
        image.loading = 'eager';
        if (typeof image.decode === 'function' && !image.complete) {
          image.decode().catch(() => {});
        }
      });

      sliderElement.querySelectorAll('video').forEach((video) => {
        video.preload = 'auto';
      });

      const options = {
        slidesPerView: 1,
        slidesPerGroup: 1,
        spaceBetween: 0,
        speed: transitionSpeed,
        // Real infinite loop: last slide continues smoothly into the first slide.
        // Media is eager-loaded above, so loop slides do not render blank.
        loop: loopEnabled && slideCount > 1,
        rewind: false,
        loopAdditionalSlides: 1,
        loopPreventsSliding: true,
        autoHeight: false,
        watchOverflow: true,
        resizeObserver: true,
        allowTouchMove: slideCount > 1,
        simulateTouch: slideCount > 1,
        grabCursor: slideCount > 1,
        waitForTransition: true,
        preventClicks: true,
        preventClicksPropagation: true,
        pagination: slideCount > 1 ? {
          el: paginationSelector,
          clickable: true
        } : false,
        autoplay: autoplayEnabled ? {
          delay: autoplayDelay,
          disableOnInteraction: false,
          pauseOnMouseEnter: false
        } : false,
        on: {
          init(swiper) {
            resetBullets(swiper);
            setActiveBulletProgress(swiper, autoplayEnabled ? 0 : 100);
            prepareAdjacentMedia(swiper);
            updateVideos(swiper);
            bindMediaEvents(sliderElement, swiper);
            bindArrowNavigation(swiper);
            syncArrowState(swiper);
            updateAutoHeight(swiper, 0);
          },
          slideChange(swiper) {
            resetBullets(swiper);
            setActiveBulletProgress(swiper, autoplayEnabled ? 0 : 100);
            prepareAdjacentMedia(swiper);
            syncArrowState(swiper);
            updateAutoHeight(swiper, 0);
          },
          slideChangeTransitionEnd(swiper) {
            prepareAdjacentMedia(swiper);
            updateVideos(swiper);
            swiper.update();
            updateAutoHeight(swiper, transitionSpeed);
          },
          resize(swiper) {
            updateVideos(swiper);
            syncArrowState(swiper);
            updateAutoHeight(swiper, 0);
          },
          autoplayTimeLeft(swiper, time, progress) {
            if (!autoplayEnabled) return;
            setActiveBulletProgress(swiper, Math.max(0, Math.min(100, (1 - progress) * 100)));
          }
        }
      };

      swiperInstance = new window.Swiper(sliderElement, options);
      bindArrowNavigation(swiperInstance);
      syncArrowState(swiperInstance);
    }

    function handleSectionLoad(event) {
      if (!event.detail || event.detail.sectionId !== sectionId) return;
      destroySwiper();
      initSwiper();
    }

    function handleSectionUnload(event) {
      if (!event.detail || event.detail.sectionId !== sectionId) return;
      destroySwiper();
    }

    function handleBlockSelect(event) {
      if (!event.detail || event.detail.sectionId !== sectionId || !swiperInstance) return;

      const blockId = event.detail.blockId;
      const sliderElement = getSliderElement();
      if (!sliderElement || !blockId) return;

      const originalSlides = Array.from(sliderElement.querySelectorAll('.swiper-slide[data-block-id]'));
      const selectedSlide = originalSlides.find((slide) => slide.dataset.blockId === blockId);
      if (!selectedSlide) return;

      const targetRealIndex = Number(selectedSlide.getAttribute('data-swiper-slide-index'));

      if (loopEnabled && Number.isFinite(targetRealIndex) && typeof swiperInstance.slideToLoop === 'function') {
        swiperInstance.slideToLoop(targetRealIndex, 0);
      } else {
        const targetIndex = originalSlides.indexOf(selectedSlide);
        if (targetIndex >= 0) swiperInstance.slideTo(targetIndex, 0);
      }
    }

    document.addEventListener('shopify:section:load', handleSectionLoad);
    document.addEventListener('shopify:section:unload', handleSectionUnload);
    document.addEventListener('shopify:block:select', handleBlockSelect);

    registry[sectionId] = {
      destroy() {
        destroySwiper();
        document.removeEventListener('shopify:section:load', handleSectionLoad);
        document.removeEventListener('shopify:section:unload', handleSectionUnload);
        document.removeEventListener('shopify:block:select', handleBlockSelect);
        delete registry[sectionId];
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSwiper, { once: true });
    } else {
      initSwiper();
    }
  })();
</script>

{% schema %}
{
  "name": "Hero Carousel Layout",
  "class": "hero-banner-carousel-layout",
  "max_blocks": 9,
  "tag": "section",
  "settings": [
    {
      "type": "radio",
      "id": "showContainer",
      "label": "Choose Container Style",
      "options": [
        { "value": "full-width", "label": "Show Full Container" },
        { "value": "page-width", "label": "Show FrameWork Container" }
      ],
      "default": "page-width"
    },
    {
      "type": "text",
      "id": "seo_text",
      "label": "Seo Tag Trigger Team",
      "info": "Used for GTM (Anil)"
    },
    {
      "type": "checkbox",
      "id": "enableShuffle",
      "label": "Auto Shuffle",
      "info": "If enabled, banners will be randomly shuffled on page load",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Infinite Loop",
      "info": "Enable infinite slider loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "select",
      "id": "autoplay_delay",
      "label": "Autoplay Delay",
      "options": [
        { "value": "3000", "label": "3 seconds" },
        { "value": "5000", "label": "5 seconds" },
        { "value": "8000", "label": "8 seconds" },
        { "value": "12000", "label": "12 seconds" },
        { "value": "16000", "label": "16 seconds" },
        { "value": "20000", "label": "20 seconds" }
      ],
      "default": "16000"
    },
    {
      "type": "range",
      "id": "pagination_margin_top",
      "label": "Mobile Pagination Bottom Space",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "slide_speed",
      "min": 100,
      "max": 2000,
      "step": 100,
      "unit": "ms",
      "label": "Slider Transition Speed",
      "default": 500
    }
  ],
  "blocks": [
    {
      "type": "image-media",
      "name": "Image Media",
      "settings": [
        {
          "type": "color_background",
          "id": "gradient_bg",
          "label": "Gradient Background"
        },
        {
          "type": "select",
          "id": "banner_top_tag",
          "label": "Banner Top Tag",
          "options": [
            { "value": "bestseller", "label": "Best Seller" },
            { "value": "hok_exclusive", "label": "Hok Exclusive" },
            { "value": "limited_stock", "label": "Limited Stock" },
            { "value": "new_launch", "label": "New Launch" },
            { "value": "new_sale", "label": "Ongoing Sale" },
            { "value": "trending", "label": "Trending" },
            { "value": "none", "label": "No Icon" }
          ],
          "default": "none"
        },
        {
          "type": "checkbox",
          "id": "full_width_image",
          "label": "Show Full Width Image (Hide Content)",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "banner_bottom_logo",
          "label": "Banner Bottom logo"
        },
        {
          "type": "url",
          "id": "banner-url",
          "label": "Banner URL"
        },
        {
          "type": "image_picker",
          "id": "banner-image-desktop",
          "label": "Banner Image Desktop",
          "info": "Default: 1080x1080. Hero banner example: 1950x735px"
        },
        {
          "type": "image_picker",
          "id": "banner-image-mobile",
          "label": "Banner Image Mobile",
          "info": "If empty, desktop image will be used on mobile"
        },
        {
          "type": "radio",
          "id": "show_gradient",
          "label": "Choose Gradient Style",
          "options": [
            { "value": "white-gradient", "label": "White Gradient" },
            { "value": "black-gradient", "label": "Black Gradient" },
            { "value": "none", "label": "No Gradient" }
          ],
          "default": "none"
        },
        {
          "type": "radio",
          "id": "gradient_condition",
