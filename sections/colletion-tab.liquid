{%- liquid
  assign s = section.settings
  assign sc = '#shopify-section-' | append: section.id

  # First block that has a collection = default active tab + initial "View all" URL
  assign first_id = ''
  assign first_url = ''
  assign valid_count = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign valid_count = valid_count | plus: 1
      if first_id == ''
        assign first_id = block.id
        assign first_url = block.settings.collection.url
      endif
    endif
  endfor
-%}

{% style %}
  {{ sc }} {
    --ct-bg: {{ s.section_background }};
    --ct-pt: {{ s.padding_top }}px;
    --ct-pb: {{ s.padding_bottom }}px;
    --ct-max-width: {{ s.max_width }}px;

    --ct-heading-size: {{ s.heading_size }}px;
    --ct-heading-weight: {{ s.heading_weight }};
    --ct-heading-color: {{ s.heading_color }};
    --ct-heading-align: {{ s.heading_alignment }};

    --ct-viewall-size: {{ s.view_all_size }}px;
    --ct-viewall-weight: {{ s.view_all_weight }};
    --ct-viewall-color: {{ s.view_all_color }};

    --ct-tab-size: {{ s.tab_size }}px;
    --ct-tab-weight: {{ s.tab_weight }};
    --ct-tab-color: {{ s.tab_color }};
    --ct-tab-color-active: {{ s.tab_color_active }};
    --ct-tab-bg: {{ s.tab_background }};
    --ct-tab-bg-active: {{ s.tab_background_active }};
    --ct-tab-radius: {{ s.tab_radius }}px;
    --ct-tab-pad-x: {{ s.tab_padding_x }}px;
    --ct-tab-pad-y: {{ s.tab_padding_y }}px;
    --ct-tab-gap: {{ s.tab_gap }}px;
    --ct-underline-color: {{ s.tab_underline_color }};
    --ct-underline-thickness: {{ s.tab_underline_thickness }}px;

    --ct-per-view: {{ s.per_view_desktop }};
    --ct-gap: {{ s.gap_desktop }}px;

    --ct-atc-spacing: {{ s.atc_spacing }}px;

    --ct-arrow-size: {{ s.arrow_size }}px;
    --ct-arrow-bg: {{ s.arrow_background }};
    --ct-arrow-color: {{ s.arrow_color }};
    --ct-arrow-radius: {{ s.arrow_radius }}px;
    --ct-arrow-offset: {{ s.arrow_offset }}px;
    --ct-arrow-top: {{ s.arrow_position_y }}%;
  }

  {{ sc }} .collection-tabs {
    display: block;
    background-color: var(--ct-bg);
    padding-top: var(--ct-pt);
    padding-bottom: var(--ct-pb);
  }

  {{ sc }} .collection-tabs *,
  {{ sc }} .collection-tabs *::before,
  {{ sc }} .collection-tabs *::after {
    box-sizing: border-box;
  }

  {{ sc }} .collection-tabs__container--custom {
    width: 100%;
    max-width: var(--ct-max-width);
    margin-left: auto;
    margin-right: auto;
    padding-left: 2.4rem;
    padding-right: 2.4rem;
  }

  /* ---------------- Header ---------------- */
  {{ sc }} .collection-tabs__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  {{ sc }} .collection-tabs__heading {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-size: var(--ct-heading-size);
    font-weight: var(--ct-heading-weight);
    line-height: 1.2;
    color: var(--ct-heading-color);
    text-align: var(--ct-heading-align);
    word-break: break-word;
  }

  {{ sc }} .collection-tabs__view-all {
    flex: 0 0 auto;
    font-size: var(--ct-viewall-size);
    font-weight: var(--ct-viewall-weight);
    color: var(--ct-viewall-color);
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
  }

  {{ sc }} .collection-tabs__view-all:hover {
    text-decoration: underline;
  }

  /* ---------------- Tabs ---------------- */
  {{ sc }} .collection-tabs__tabsbar {
    position: relative;
    margin-bottom: 18px;
  }

  {{ sc }} .collection-tabs__tabs {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--ct-tab-gap);
    padding: 2px 0;
    overflow-x: auto;
    white-space: nowrap;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  {{ sc }} .collection-tabs__tabs::-webkit-scrollbar {
    display: none;
  }

  {{ sc }} .collection-tabs__tab {
    position: relative;
    flex: 0 0 auto;
    appearance: none;
    border: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: var(--ct-tab-size);
    font-weight: var(--ct-tab-weight);
    line-height: 1.2;
    color: var(--ct-tab-color);
    background-color: var(--ct-tab-bg);
    border-radius: var(--ct-tab-radius);
    padding: var(--ct-tab-pad-y) var(--ct-tab-pad-x);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  {{ sc }} .collection-tabs__tab:hover {
    color: var(--ct-tab-color-active);
  }

  {{ sc }} .collection-tabs__tab.is-active {
    color: var(--ct-tab-color-active);
    background-color: var(--ct-tab-bg-active);
  }

  {{ sc }} .collection-tabs__tab:focus-visible {
    outline: 2px solid var(--ct-tab-color-active);
    outline-offset: 2px;
  }

  {%- if s.show_tab_underline %}
  {{ sc }} .collection-tabs__tab.is-active::after {
    content: '';
    position: absolute;
    left: var(--ct-tab-pad-x);
    right: var(--ct-tab-pad-x);
    bottom: 0;
    height: var(--ct-underline-thickness);
    background-color: var(--ct-underline-color);
    border-radius: 2px;
  }
  {%- endif %}

  {{ sc }} .collection-tabs__tab-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    cursor: pointer;
    border-radius: 50%;
    background-color: var(--ct-tab-bg-active);
    color: var(--ct-tab-color-active);
    box-shadow: 0 0 0 6px var(--ct-bg);
  }

  {{ sc }} .collection-tabs__tab-nav svg {
    width: 12px;
    height: 12px;
  }

  {{ sc }} .collection-tabs__tab-nav[hidden] {
    display: none;
  }

  {{ sc }} .collection-tabs__tab-nav--prev {
    left: 0;
  }

  {{ sc }} .collection-tabs__tab-nav--next {
    right: 0;
  }

  /* ---------------- Panels + slider ---------------- */
  {{ sc }} .collection-tabs__panel[hidden] {
    display: none;
  }

  {{ sc }} .collection-tabs__slider-wrap {
    position: relative;
  }

  {{ sc }} .collection-tabs__slider {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--ct-gap);
    margin: 0;
    padding: 4px 4px 20px;
    list-style: none;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  {{ sc }} .collection-tabs__slider::-webkit-scrollbar {
    display: none;
  }

  {{ sc }} .collection-tabs-product {
    flex: 0 0 calc((100% - (var(--ct-per-view) - 1) * var(--ct-gap)) / var(--ct-per-view));
    display: flex;
    flex-direction: column;
    min-width: 0;
    scroll-snap-align: start;
  }

  /* Wrapper-level only: lets the theme card stretch so every ATC lines up. */
  {{ sc }} .collection-tabs-product > *:not(.collection-tabs-product__atc) {
    flex: 1 1 auto;
    min-width: 0;
  }

  {{ sc }} .collection-tabs-product__atc {
    flex: 0 0 auto;
    margin-top: var(--ct-atc-spacing);
  }

  {{ sc }} .collection-tabs__arrow {
    position: absolute;
    top: var(--ct-arrow-top);
    transform: translateY(-50%);
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ct-arrow-size);
    height: var(--ct-arrow-size);
    padding: 0;
    cursor: pointer;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--ct-arrow-radius);
    background-color: var(--ct-arrow-bg);
    color: var(--ct-arrow-color);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    transition: opacity 0.15s ease, visibility 0.15s ease;
  }

  {{ sc }} .collection-tabs__arrow svg {
    width: 40%;
    height: 40%;
  }

  {{ sc }} .collection-tabs__arrow.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  {{ sc }} .collection-tabs__arrow--prev {
    left: var(--ct-arrow-offset);
  }

  {{ sc }} .collection-tabs__arrow--next {
    right: var(--ct-arrow-offset);
  }

  {{ sc }} .collection-tabs__empty {
    margin: 0;
    padding: 28px 0;
    font-size: 1.4rem;
    opacity: 0.7;
  }

  {{ sc }} .collection-tabs__onboarding {
    padding: 24px;
    border: 1px dashed currentColor;
    border-radius: 6px;
    font-size: 1.4rem;
    opacity: 0.7;
  }

  /* ---------------- Tablet ---------------- */
  @media screen and (max-width: 989px) {
    {{ sc }} {
      --ct-per-view: {{ s.per_view_tablet }};
      --ct-gap: {{ s.gap_tablet }}px;
    }
  }

  /* ---------------- Mobile ---------------- */
  @media screen and (max-width: 749px) {
    {{ sc }} {
      --ct-pt: {{ s.padding_top_mobile }}px;
      --ct-pb: {{ s.padding_bottom_mobile }}px;
      --ct-heading-size: {{ s.heading_size_mobile }}px;
      --ct-tab-size: {{ s.tab_size_mobile }}px;
      --ct-tab-gap: {{ s.tab_gap_mobile }}px;
      --ct-per-view: {{ s.per_view_mobile }};
      --ct-gap: {{ s.gap_mobile }}px;
    }

    {{ sc }} .collection-tabs__container--custom {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    {{ sc }} .collection-tabs__header {
      margin-bottom: 12px;
    }

    {%- unless s.show_arrows_mobile %}
    {{ sc }} .collection-tabs__arrow {
      display: none;
    }
    {%- endunless %}
  }

  @media (prefers-reduced-motion: reduce) {
    {{ sc }} .collection-tabs__slider,
    {{ sc }} .collection-tabs__tabs {
      scroll-behavior: auto;
    }
  }
{% endstyle %}

<collection-tabs-slider class="collection-tabs" data-section-id="{{ section.id }}">
  <div class="collection-tabs__container {% if s.use_page_width %}page-width{% else %}collection-tabs__container--custom{% endif %}">
    {%- if valid_count == 0 -%}
      {%- if request.design_mode -%}
        <div class="collection-tabs__onboarding">
          Add a “Collection tab” block and choose a collection to show products here.
        </div>
      {%- endif -%}
    {%- else -%}
      {%- if s.heading != blank or s.show_view_all -%}
        <div class="collection-tabs__header">
          {%- if s.heading != blank -%}
            <h2 class="collection-tabs__heading">{{ s.heading | escape }}</h2>
          {%- else -%}
            <span class="collection-tabs__heading"></span>
          {%- endif -%}

          {%- if s.show_view_all and s.view_all_text != blank and first_url != blank -%}
            <a class="collection-tabs__view-all" href="{{ first_url }}" data-ct-view-all>
              {{- s.view_all_text | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="collection-tabs__tabsbar">
        <div
          class="collection-tabs__tabs"
          role="tablist"
          aria-label="{{ s.heading | default: 'Collections' | escape }}"
          data-ct-tabs
        >
          {%- for block in section.blocks -%}
            {%- if block.settings.collection != blank -%}
              {%- assign is_active = false -%}
              {%- if block.id == first_id -%}
                {%- assign is_active = true -%}
              {%- endif -%}
              <button
                type="button"
                class="collection-tabs__tab{% if is_active %} is-active{% endif %}"
                id="CollectionTabsTab-{{ section.id }}-{{ block.id }}"
                role="tab"
                aria-selected="{% if is_active %}true{% else %}false{% endif %}"
                aria-controls="CollectionTabsPanel-{{ section.id }}-{{ block.id }}"
                tabindex="{% if is_active %}0{% else %}-1{% endif %}"
                data-ct-tab="{{ block.id }}"
                data-ct-url="{{ block.settings.collection.url }}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.tab_title | default: block.settings.collection.title | escape -}}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if s.show_tab_arrows -%}
          <button
            type="button"
            class="collection-tabs__tab-nav collection-tabs__tab-nav--prev"
            data-ct-tab-nav="prev"
            aria-label="Scroll tabs left"
            hidden
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="collection-tabs__tab-nav collection-tabs__tab-nav--next"
            data-ct-tab-nav="next"
            aria-label="Scroll tabs right"
            hidden
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}
      </div>

      <div class="collection-tabs__panels">
        {%- for block in section.blocks -%}
          {%- assign collection = block.settings.collection -%}
          {%- if collection != blank -%}
            {%- assign is_active = false -%}
            {%- if block.id == first_id -%}
              {%- assign is_active = true -%}
            {%- endif -%}

            <div
              class="collection-tabs__panel"
              id="CollectionTabsPanel-{{ section.id }}-{{ block.id }}"
              role="tabpanel"
              aria-labelledby="CollectionTabsTab-{{ section.id }}-{{ block.id }}"
              tabindex="0"
              data-ct-panel="{{ block.id }}"
              {% unless is_active %}hidden{% endunless %}
            >
              {%- if collection.products.size > 0 -%}
                <div class="collection-tabs__slider-wrap">
                  <ul class="collection-tabs__slider" role="list" data-ct-slider>
                    {%- for product in collection.products limit: s.products_to_show -%}
                      {%- assign current_variant = product.selected_or_first_available_variant -%}
                      {%- capture product_form_id -%}
                        collection-tab-product-form-{{ section.id }}-{{ block.id }}-{{ product.id }}
                      {%- endcapture -%}
                      {%- assign product_form_id = product_form_id | strip -%}

                      <li class="collection-tabs-product">
                        {% render 'card-product',
                          card_product: product,
                          media_aspect_ratio: s.image_ratio,
                          image_shape: 'default',
                          show_secondary_image: s.show_secondary_image,
                          show_vendor: s.show_vendor,
                          show_rating: s.show_rating,
                          lazy_load: true,
                          quick_add: 'none',
                          section_id: section.id
                        %}

                        <div class="collection-tabs-product__atc">
                          {% render 'custom-atc',
                            card_product: product,
                            card_product: product,
                            variant: current_variant,
                            current_variant: current_variant,
                            product_form_id: product_form_id,
                            section_id: section.id,
                            block_id: block.id
                          %}
                        </div>
                      </li>
                    {%- endfor -%}
                  </ul>

                  {%- if s.show_arrows -%}
                    <button
                      type="button"
                      class="collection-tabs__arrow collection-tabs__arrow--prev is-hidden"
                      data-ct-arrow="prev"
                      aria-label="Show previous products"
                      aria-controls="CollectionTabsPanel-{{ section.id }}-{{ block.id }}"
                      disabled
                    >
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                        <path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="collection-tabs__arrow collection-tabs__arrow--next"
                      data-ct-arrow="next"
                      aria-label="Show next products"
                      aria-controls="CollectionTabsPanel-{{ section.id }}-{{ block.id }}"
                    >
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                        <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  {%- endif -%}
                </div>
              {%- else -%}
                <p class="collection-tabs__empty">{{ s.empty_text | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</collection-tabs-slider>

<script>
  (function () {
    if (customElements.get('collection-tabs-slider')) return;

    customElements.define(
      'collection-tabs-slider',
      class CollectionTabsSlider extends HTMLElement {
        constructor() {
          super();
          this.handleBlockSelect = this.handleBlockSelect.bind(this);
          this.handleKeydown = this.handleKeydown.bind(this);
          this.refresh = this.refresh.bind(this);
          this.schedule = this.schedule.bind(this);
          this.frame = null;
        }

        connectedCallback() {
          this.tabs = Array.prototype.slice.call(this.querySelectorAll('[data-ct-tab]'));
          this.panels = Array.prototype.slice.call(this.querySelectorAll('[data-ct-panel]'));
          this.viewAll = this.querySelector('[data-ct-view-all]');
          this.tabsTrack = this.querySelector('[data-ct-tabs]');
          this.tabNavs = Array.prototype.slice.call(this.querySelectorAll('[data-ct-tab-nav]'));

          if (!this.tabs.length) return;

          var self = this;

          this.tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
              self.activate(tab.getAttribute('data-ct-tab'), false);
            });
          });

          if (this.tabsTrack) {
            this.tabsTrack.addEventListener('keydown', this.handleKeydown);
            this.tabsTrack.addEventListener('scroll', this.schedule, { passive: true });
          }

          this.tabNavs.forEach(function (button) {
            button.addEventListener('click', function () {
              self.scrollTabs(button.getAttribute('data-ct-tab-nav'));
            });
          });

          this.panels.forEach(function (panel) {
            var slider = panel.querySelector('[data-ct-slider]');
            if (!slider) return;

            slider.addEventListener('scroll', self.schedule, { passive: true });

            Array.prototype.forEach.call(panel.querySelectorAll('[data-ct-arrow]'), function (button) {
              button.addEventListener('click', function () {
                self.scrollSlider(slider, button.getAttribute('data-ct-arrow'));
              });
            });
          });

          document.addEventListener('shopify:block:select', this.handleBlockSelect);

          if ('ResizeObserver' in window) {
            this.observer = new ResizeObserver(this.schedule);
            this.observer.observe(this);
          } else {
            window.addEventListener('resize', this.schedule);
          }

          this.refresh();
        }

        disconnectedCallback() {
          document.removeEventListener('shopify:block:select', this.handleBlockSelect);
          window.removeEventListener('resize', this.schedule);
          if (this.observer) this.observer.disconnect();
          if (this.frame) window.cancelAnimationFrame(this.frame);
        }

        /* ---------------- Tabs ---------------- */
        activate(id, moveFocus) {
          var self = this;

          this.tabs.forEach(function (tab) {
            var isActive = tab.getAttribute('data-ct-tab') === id;
            tab.classList.toggle('is-active', isActive);
            tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
            tab.setAttribute('tabindex', isActive ? '0' : '-1');

            if (!isActive) return;

            var url = tab.getAttribute('data-ct-url');
            if (self.viewAll && url) self.viewAll.setAttribute('href', url);
            if (moveFocus) tab.focus();
            if (typeof tab.scrollIntoView === 'function') {
              tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
            }
          });

          this.panels.forEach(function (panel) {
            var isActive = panel.getAttribute('data-ct-panel') === id;
            if (isActive) {
              panel.removeAttribute('hidden');
              var slider = panel.querySelector('[data-ct-slider]');
              if (slider) slider.scrollLeft = 0;
            } else {
              panel.setAttribute('hidden', '');
            }
          });

          this.refresh();
        }

        handleKeydown(event) {
          var current = this.tabs.indexOf(document.activeElement);
          if (current === -1) return;

          var target = -1;
          if (event.key === 'ArrowRight') target = (current + 1) % this.tabs.length;
          else if (event.key === 'ArrowLeft') target = (current - 1 + this.tabs.length) % this.tabs.length;
          else if (event.key === 'Home') target = 0;
          else if (event.key === 'End') target = this.tabs.length - 1;
          else return; /* Enter and Space fire a native click on the button */

          event.preventDefault();
          this.activate(this.tabs[target].getAttribute('data-ct-tab'), true);
        }

        scrollTabs(direction) {
          if (!this.tabsTrack) return;
          var amount = this.tabsTrack.clientWidth * 0.7;
          this.tabsTrack.scrollBy({
            left: direction === 'next' ? amount : -amount,
            behavior: 'smooth'
          });
        }

        updateTabNav() {
          if (!this.tabsTrack || !this.tabNavs.length) return;
          var max = this.tabsTrack.scrollWidth - this.tabsTrack.clientWidth;
          var pos = Math.abs(this.tabsTrack.scrollLeft);

          this.tabNavs.forEach(function (button) {
            var isNext = button.getAttribute('data-ct-tab-nav') === 'next';
            var hide = max <= 2 || (isNext ? pos >= max - 2 : pos <= 2);
            button.hidden = hide;
          });
        }

        /* ---------------- Slider ---------------- */
        scrollSlider(slider, direction) {
          var amount = this.scrollAmount(slider);
          slider.scrollBy({
            left: direction === 'next' ? amount : -amount,
            behavior: 'smooth'
          });
        }

        scrollAmount(slider) {
          var item = slider.querySelector('.collection-tabs-product');
          if (!item) return slider.clientWidth;

          var styles = window.getComputedStyle(slider);
          var gap = parseFloat(styles.columnGap || styles.gap) || 0;
          var step = item.getBoundingClientRect().width + gap;
          if (!step) return slider.clientWidth;

          var perPage = Math.max(1, Math.floor((slider.clientWidth + gap) / step));
          return step * perPage;
        }

        updateArrows(panel) {
          var slider = panel.querySelector('[data-ct-slider]');
          if (!slider) return;

          var max = slider.scrollWidth - slider.clientWidth;
          var pos = Math.abs(slider.scrollLeft);
          var atStart = pos <= 2;
          var atEnd = max <= 2 || pos >= max - 2;

          var prev = panel.querySelector('[data-ct-arrow="prev"]');
          var next = panel.querySelector('[data-ct-arrow="next"]');

          if (prev) {
            prev.disabled = atStart;
            prev.classList.toggle('is-hidden', atStart);
          }
          if (next) {
            next.disabled = atEnd;
            next.classList.toggle('is-hidden', atEnd);
          }
        }

        /* ---------------- Shared ---------------- */
        schedule() {
          if (this.frame) window.cancelAnimationFrame(this.frame);
          this.frame = window.requestAnimationFrame(this.refresh);
        }

        refresh() {
          this.frame = null;
          var active = this.panels.filter(function (panel) {
            return !panel.hasAttribute('hidden');
          })[0];
          if (active) this.updateArrows(active);
          this.updateTabNav();
        }

        handleBlockSelect(event) {
          if (!event.target || !event.target.closest) return;
          var tab = event.target.closest('[data-ct-tab]');
          if (!tab || !this.contains(tab)) return;
          this.activate(tab.getAttribute('data-ct-tab'), false);
        }
      }
    );
  })();
</script>

