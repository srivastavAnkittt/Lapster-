{%- comment -%}
  ============================================================================
  Section: Collection Tabs Slider
  File:    sections/collection-tabs-slider.liquid

  - Collection tabs are section blocks (tab title + collection picker)
  - Products render through Liquid (no JS collection fetching)
  - Horizontal scroll-snap slider, vanilla JS arrows
  - Product UI uses snippets/card-product.liquid
  - ATC UI/logic uses snippets/custim-atc.liquid
  - All CSS scoped to #shopify-section-{{ section.id }}
  - Safe to place multiple times on the same page
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  # First block with a collection selected = default active tab + initial VIEW ALL url
  assign first_id = ''
  assign first_url = ''
  assign valid_count = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign valid_count = valid_count | plus: 1
      if first_id == ''
        assign first_id = block.id
        assign first_url = block.settings.collection.url
      endif
    endif
  endfor

  case s.image_ratio
    when 'square'
      assign ratio_css = '1 / 1'
    when 'portrait'
      assign ratio_css = '3 / 4'
    when 'landscape'
      assign ratio_css = '4 / 3'
    else
      assign ratio_css = 'auto'
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} .ct-section {
    --ct-bg: {{ s.section_background }};
    --ct-pt: {{ s.padding_top }}px;
    --ct-pb: {{ s.padding_bottom }}px;

    --ct-heading-size: {{ s.heading_size }}px;
    --ct-heading-weight: {{ s.heading_weight }};
    --ct-heading-color: {{ s.heading_color }};
    --ct-heading-spacing: {{ s.heading_letter_spacing }}px;

    --ct-viewall-size: {{ s.view_all_size }}px;
    --ct-viewall-weight: {{ s.view_all_weight }};
    --ct-viewall-color: {{ s.view_all_color }};

    --ct-tab-size: {{ s.tab_size }}px;
    --ct-tab-weight: {{ s.tab_weight }};
    --ct-tab-color: {{ s.tab_color }};
    --ct-tab-color-active: {{ s.tab_color_active }};
    --ct-tab-bg: {{ s.tab_background }};
    --ct-tab-bg-active: {{ s.tab_background_active }};
    --ct-tab-radius: {{ s.tab_radius }}px;
    --ct-tab-gap: {{ s.tab_gap }}px;
    --ct-tab-pad-x: {{ s.tab_padding_x }}px;
    --ct-tab-pad-y: {{ s.tab_padding_y }}px;

    --ct-per-view: {{ s.per_view_desktop }};
    --ct-gap: {{ s.gap_desktop }}px;

    --ct-card-bg: {{ s.card_background }};
    --ct-card-border: {{ s.card_border_color }};
    --ct-card-border-width: {{ s.card_border_width }}px;
    --ct-card-radius: {{ s.card_radius }}px;
    --ct-card-pad: {{ s.card_padding }}px;
    --ct-ratio: {{ ratio_css }};

    --ct-badge-bg: {{ s.badge_background }};
    --ct-badge-color: {{ s.badge_text_color }};
    --ct-badge-size: {{ s.badge_font_size }}px;
    --ct-badge-radius: {{ s.badge_radius }}px;

    --ct-title-size: {{ s.title_size }}px;
    --ct-title-weight: {{ s.title_weight }};
    --ct-title-color: {{ s.title_color }};
    --ct-title-lines: {{ s.title_lines }};

    --ct-subtitle-size: {{ s.subtitle_size }}px;
    --ct-subtitle-color: {{ s.subtitle_color }};

    --ct-price-size: {{ s.price_size }}px;
    --ct-price-weight: {{ s.price_weight }};
    --ct-price-color: {{ s.price_color }};
    --ct-compare-color: {{ s.compare_price_color }};

    --ct-discount-bg: {{ s.discount_background }};
    --ct-discount-color: {{ s.discount_text_color }};
    --ct-discount-border: {{ s.discount_border_color }};
    --ct-discount-radius: {{ s.discount_radius }}px;
    --ct-discount-size: {{ s.discount_font_size }}px;

    --ct-swatch-size: {{ s.swatch_size }}px;

    --ct-emi-size: {{ s.emi_font_size }}px;
    --ct-emi-color: {{ s.emi_text_color }};
    --ct-emi-link-color: {{ s.emi_link_color }};

    --ct-btn-bg: {{ s.button_background }};
    --ct-btn-color: {{ s.button_text_color }};
    --ct-btn-bg-hover: {{ s.button_background_hover }};
    --ct-btn-size: {{ s.button_font_size }}px;
    --ct-btn-weight: {{ s.button_weight }};
    --ct-btn-radius: {{ s.button_radius }}px;
    --ct-btn-height: {{ s.button_height }}px;

    --ct-arrow-size: {{ s.arrow_size }}px;
    --ct-arrow-bg: {{ s.arrow_background }};
    --ct-arrow-color: {{ s.arrow_color }};
    --ct-arrow-radius: {{ s.arrow_radius }}px;
  }

  #shopify-section-{{ section.id }} .ct-section {
    background-color: var(--ct-bg);
    padding-top: var(--ct-pt);
    padding-bottom: var(--ct-pb);

    & *,
    & *::before,
    & *::after {
      box-sizing: border-box;
    }

    /* ---------- Header ---------- */
    & .ct-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 14px;
    }

    & .ct-heading {
      margin: 0;
      font-size: var(--ct-heading-size);
      font-weight: var(--ct-heading-weight);
      line-height: 1.2;
      letter-spacing: var(--ct-heading-spacing);
      color: var(--ct-heading-color);
      word-break: break-word;
    }

    & .ct-viewall {
      flex: 0 0 auto;
      margin-top: 4px;
      font-size: var(--ct-viewall-size);
      font-weight: var(--ct-viewall-weight);
      color: var(--ct-viewall-color);
      letter-spacing: 0.04em;
      text-decoration: none;
      white-space: nowrap;

      &:hover {
        text-decoration: underline;
      }
    }

    /* ---------- Tabs ---------- */
    & .ct-tabsbar {
      position: relative;
      margin-bottom: 18px;
    }

    & .ct-tabs {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: var(--ct-tab-gap);
      overflow-x: auto;
      white-space: nowrap;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding: 2px 0;

      &::-webkit-scrollbar {
        display: none;
      }
    }

    & .ct-tab {
      flex: 0 0 auto;
      appearance: none;
      border: 0;
      cursor: pointer;
      background-color: var(--ct-tab-bg);
      color: var(--ct-tab-color);
      font-size: var(--ct-tab-size);
      font-weight: var(--ct-tab-weight);
      font-family: inherit;
      line-height: 1.2;
      border-radius: var(--ct-tab-radius);
      padding: var(--ct-tab-pad-y) var(--ct-tab-pad-x);
      transition: color 0.15s ease, background-color 0.15s ease;

      &:hover {
        color: var(--ct-tab-color-active);
      }

      &.is-active {
        color: var(--ct-tab-color-active);
        background-color: var(--ct-tab-bg-active);
        font-weight: 700;
      }

      &:focus-visible {
        outline: 2px solid var(--ct-tab-color-active);
        outline-offset: 2px;
      }
    }

    & .ct-tabnav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 0;
      cursor: pointer;
      border-radius: 50%;
      background-color: #e9eaee;
      color: #2b2b2b;
      box-shadow: 0 0 0 4px var(--ct-bg);

      & svg {
        width: 12px;
        height: 12px;
      }

      &[hidden] {
        display: none;
      }

      &.ct-tabnav--prev {
        left: 0;
      }

      &.ct-tabnav--next {
        right: 0;
      }
    }

    /* ---------- Panels + slider ---------- */
    & .ct-panel[hidden] {
      display: none;
    }

    & .ct-slider-wrap {
      position: relative;
    }

    & .ct-slider {
      display: flex;
      flex-wrap: nowrap;
      gap: var(--ct-gap);
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding: 2px 2px 22px;
      margin: -2px -2px -18px;

      &::-webkit-scrollbar {
        display: none;
      }
    }

    & .ct-arrow {
      position: absolute;
      top: 34%;
      transform: translateY(-50%);
      z-index: 4;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--ct-arrow-size);
      height: var(--ct-arrow-size);
      padding: 0;
      border: 1px solid rgba(0, 0, 0, 0.08);
      cursor: pointer;
      border-radius: var(--ct-arrow-radius);
      background-color: var(--ct-arrow-bg);
      color: var(--ct-arrow-color);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
      transition: opacity 0.15s ease, visibility 0.15s ease;

      & svg {
        width: 40%;
        height: 40%;
      }

      &.is-hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      &.ct-arrow--prev {
        left: 6px;
      }

      &.ct-arrow--next {
        right: 6px;
      }
    }

    & .ct-empty {
      margin: 0;
      padding: 28px 0;
      font-size: 14px;
      color: var(--ct-subtitle-color);
    }

    /* ---------- Product card ---------- */
    & .ct-card {
      flex: 0 0 calc((100% - (var(--ct-per-view) - 1) * var(--ct-gap)) / var(--ct-per-view));
      min-width: 0;
      display: flex;
      flex-direction: column;
      scroll-snap-align: start;
    }

    & .ct-card-product,
    & .ct-card-product .card-wrapper {
      width: 100%;
      min-width: 0;
    }

    & .ct-custom-atc {
      width: 100%;
      margin-top: 12px;
    }

    & .ct-media {
      position: relative;
      display: block;
      padding: var(--ct-card-pad) var(--ct-card-pad) 0;
      border-bottom: 1px solid var(--ct-card-border);
      text-decoration: none;

      & .ct-media-inner {
        position: relative;
        width: 100%;
        aspect-ratio: var(--ct-ratio);
        overflow: hidden;
      }

      & img,
      & svg {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }

    & .ct-badge {
      position: absolute;
      left: var(--ct-card-pad);
      right: var(--ct-card-pad);
      bottom: 0;
      transform: translateY(50%);
      z-index: 2;
      display: block;
      padding: 4px 8px;
      text-align: center;
      font-size: var(--ct-badge-size);
      font-weight: 500;
      line-height: 1.3;
      color: var(--ct-badge-color);
      background-color: var(--ct-badge-bg);
      border-radius: var(--ct-badge-radius);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    & .ct-body {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      padding: calc(var(--ct-card-pad) + 12px) var(--ct-card-pad) var(--ct-card-pad);
    }

    & .ct-titlerow {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 8px;
    }

    & .ct-title {
      display: -webkit-box;
      -webkit-line-clamp: var(--ct-title-lines);
      line-clamp: var(--ct-title-lines);
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin: 0;
      font-size: var(--ct-title-size);
      font-weight: var(--ct-title-weight);
      line-height: 1.3;
      color: var(--ct-title-color);
      text-decoration: none;
      {%- if s.title_uppercase %}
      text-transform: uppercase;
      {%- endif %}

      &:hover {
        text-decoration: underline;
      }
    }

    & .ct-swatches {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      gap: 0;
      margin-top: 2px;
    }

    & .ct-swatch {
      width: var(--ct-swatch-size);
      height: var(--ct-swatch-size);
      border-radius: 50%;
      background-color: #d9d9d9;
      background-size: cover;
      background-position: center;
      border: 1px solid rgba(0, 0, 0, 0.15);
      margin-left: -5px;

      &:first-child {
        margin-left: 0;
      }
    }

    & .ct-swatch-more {
      margin-left: 5px;
      font-size: 11px;
      line-height: 1;
      color: var(--ct-subtitle-color);
    }

    & .ct-subtitle {
      display: -webkit-box;
      -webkit-line-clamp: 1;
      line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin: 6px 0 0;
      font-size: var(--ct-subtitle-size);
      line-height: 1.4;
      color: var(--ct-subtitle-color);
    }

    & .ct-pricerow {
      display: flex;
      align-items: center;
      flex-wrap: nowrap;
      gap: 8px;
      margin-top: 12px;
    }

    & .ct-price {
      font-size: var(--ct-price-size);
      font-weight: var(--ct-price-weight);
      line-height: 1.1;
      color: var(--ct-price-color);
      white-space: nowrap;
    }

    & .ct-compare {
      font-size: calc(var(--ct-price-size) * 0.62);
      color: var(--ct-compare-color);
      text-decoration: line-through;
      white-space: nowrap;
    }

    & .ct-discount {
      margin-left: auto;
      flex: 0 0 auto;
      padding: 4px 9px;
      font-size: var(--ct-discount-size);
      font-weight: 700;
      line-height: 1;
      white-space: nowrap;
      color: var(--ct-discount-color);
      background-color: var(--ct-discount-bg);
      border: 1px solid var(--ct-discount-border);
      border-radius: var(--ct-discount-radius);
    }

    & .ct-emi {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 4px;
      margin: 10px 0 0;
      font-size: var(--ct-emi-size);
      line-height: 1.3;
      color: var(--ct-emi-color);
    }

    & .ct-emi-link {
      color: var(--ct-emi-link-color);
      text-decoration: none;
      font-weight: 500;

      &:hover {
        text-decoration: underline;
      }
    }

    & .ct-atc {
      width: 100%;
      margin-top: 14px;
      min-height: var(--ct-btn-height);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 8px 12px;
      border: 0;
      cursor: pointer;
      font-family: inherit;
      font-size: var(--ct-btn-size);
      font-weight: var(--ct-btn-weight);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ct-btn-color);
      background-color: var(--ct-btn-bg);
      border-radius: var(--ct-btn-radius);
      transition: background-color 0.15s ease, opacity 0.15s ease;

      &:hover:not([disabled]) {
        background-color: var(--ct-btn-bg-hover);
      }

      &[disabled] {
        cursor: not-allowed;
        opacity: 0.55;
      }
    }

    & .ct-atc-push {
      margin-top: auto;
    }

    & .ct-onboarding {
      padding: 24px;
      border: 1px dashed var(--ct-card-border);
      border-radius: var(--ct-card-radius);
      font-size: 14px;
      color: var(--ct-subtitle-color);
    }
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .ct-section {
      --ct-per-view: {{ s.per_view_tablet }};
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .ct-section {
      --ct-pt: {{ s.padding_top_mobile }}px;
      --ct-pb: {{ s.padding_bottom_mobile }}px;
      --ct-heading-size: {{ s.heading_size_mobile }}px;
      --ct-tab-size: {{ s.tab_size_mobile }}px;
      --ct-tab-gap: {{ s.tab_gap_mobile }}px;
      --ct-per-view: {{ s.per_view_mobile }};
      --ct-gap: {{ s.gap_mobile }}px;
      --ct-title-size: {{ s.title_size_mobile }}px;
      --ct-price-size: {{ s.price_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .ct-section {
      & .ct-header {
        align-items: center;
        margin-bottom: 12px;
      }

      & .ct-viewall {
        margin-top: 0;
      }

      & .ct-heading {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      {%- unless s.show_arrows_mobile %}
      & .ct-arrow {
        display: none;
      }
      {%- endunless %}
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .ct-section {
      & .ct-slider,
      & .ct-tabs {
        scroll-behavior: auto;
      }
    }
  }
{% endstyle %}

<div class="ct-section" data-ct-section="{{ section.id }}">
  <div class="page-width">
    {%- if valid_count == 0 -%}
      {%- if request.design_mode -%}
        <div class="ct-onboarding">
          Add a “Collection tab” block and pick a collection to display products here.
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="ct-header">
        {%- if s.heading != blank -%}
          <h2 class="ct-heading">{{ s.heading | escape }}</h2>
        {%- else -%}
          <span></span>
        {%- endif -%}

        {%- if s.view_all_text != blank and first_url != blank -%}
          <a
            class="ct-viewall"
            href="{{ first_url }}"
            data-ct-viewall
          >{{ s.view_all_text | escape }}</a>
        {%- endif -%}
      </div>

      <div class="ct-tabsbar">
        <div
          class="ct-tabs"
          role="tablist"
          aria-label="{{ s.heading | default: 'Collections' | escape }}"
          data-ct-tabs
        >
          {%- for block in section.blocks -%}
            {%- if block.settings.collection != blank -%}
              {%- assign is_active = false -%}
              {%- if block.id == first_id -%}
                {%- assign is_active = true -%}
              {%- endif -%}
              <button
                type="button"
                class="ct-tab{% if is_active %} is-active{% endif %}"
                id="ct-tab-{{ section.id }}-{{ block.id }}"
                role="tab"
                aria-selected="{% if is_active %}true{% else %}false{% endif %}"
                aria-controls="ct-panel-{{ section.id }}-{{ block.id }}"
                tabindex="{% if is_active %}0{% else %}-1{% endif %}"
                data-ct-tab="{{ block.id }}"
                data-collection-url="{{ block.settings.collection.url }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.tab_title | default: block.settings.collection.title | escape }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <button
          type="button"
          class="ct-tabnav ct-tabnav--prev"
          data-ct-tabnav="prev"
          aria-label="Scroll tabs left"
          hidden
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="ct-tabnav ct-tabnav--next"
          data-ct-tabnav="next"
          aria-label="Scroll tabs right"
          hidden
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div class="ct-panels">
        {%- for block in section.blocks -%}
          {%- if block.settings.collection != blank -%}
            {%- assign coll = block.settings.collection -%}
            {%- assign is_active = false -%}
            {%- if block.id == first_id -%}
              {%- assign is_active = true -%}
            {%- endif -%}

            <div
              class="ct-panel"
              id="ct-panel-{{ section.id }}-{{ block.id }}"
              role="tabpanel"
              aria-labelledby="ct-tab-{{ section.id }}-{{ block.id }}"
              data-ct-panel="{{ block.id }}"
              tabindex="0"
              {% unless is_active %}hidden{% endunless %}
            >
              {%- if coll.products.size > 0 -%}
                <div class="ct-slider-wrap">
                  <div class="ct-slider" data-ct-slider>
                    {%- for product in coll.products limit: s.products_to_show -%}
                      {%- liquid
                        assign current_variant = product.selected_or_first_available_variant
                        assign product_form_id = 'ct-product-form-' | append: section.id | append: '-' | append: block.id | append: '-' | append: product.id
                        assign card_lazy_load = true
                        if is_active and forloop.index <= 2
                          assign card_lazy_load = false
                        endif
                      -%}

                      <div class="ct-card">
                        <div class="ct-card-product">
                          {% render 'card-product',
                            card_product: product,
                            media_aspect_ratio: s.image_ratio,
                            image_shape: 'default',
                            show_secondary_image: true,
                            show_vendor: false,
                            show_rating: false,
                            lazy_load: card_lazy_load,
                            skip_styles: false,
                            quick_add: 'none',
                            section_id: section.id
                          %}
                        </div>

                        <div class="ct-custom-atc">
                          {% render 'custom-atc',
                            product: product,
                            card_product: product,
                            variant: current_variant,
                            current_variant: current_variant,
                            product_form_id: product_form_id,
                            section_id: section.id
                          %}
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>

                  {%- if s.show_arrows -%}
                    <button
                      type="button"
                      class="ct-arrow ct-arrow--prev is-hidden"
                      data-ct-arrow="prev"
                      aria-label="Previous products"
                      disabled
                    >
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                        <path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="ct-arrow ct-arrow--next"
                      data-ct-arrow="next"
                      aria-label="Next products"
                    >
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                        <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  {%- endif -%}
                </div>
              {%- else -%}
                <p class="ct-empty">{{ s.empty_text | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
